# Copy this file to ".env" and fill in your PayPal *Sandbox* credentials
# (developer.paypal.com -> Apps & Credentials -> Sandbox). Never commit the real .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: the site re-downloads all World Bank data in the background when its stored copy is older than this many hours (0 = off)
# AUTO_SYNC_HOURS=24
# Optional: Claude API key for the chatbot's LLM mode
# ANTHROPIC_API_KEY=
